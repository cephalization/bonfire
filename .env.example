# Copy this file to `.env` (repo root).
# Docker Compose automatically reads `.env` for variable substitution.

# --- Authentication ---

# Secret used to sign session cookies and tokens.
#
# Required in production: the API refuses to start without it, and refuses to
# start if it is left at the development default.
# Generate one with: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Who may create an account. By default only the first user of a server and
# people holding a pending invitation can sign up; set this to `true` to let
# anyone who can reach the server register.
# BONFIRE_OPEN_SIGNUP=false

# Extra browser origins allowed to make credentialed requests, comma-separated.
# The API's own origin (BONFIRE_URL) is always allowed, and in development so
# is the Vite dev server on http://localhost:5173.
# BONFIRE_TRUSTED_ORIGINS=https://bonfire.example.com

# Where the web app is served, used for invitation links written to the log.
# Defaults to BONFIRE_URL in production and http://localhost:5173 otherwise.
# BONFIRE_WEB_URL=

# --- Server ---

# Port the API listens on. Defaults to 3000.
# PORT=3000

# Public base URL the browser reaches the API at. Session cookies and origin
# checks are tied to it. Behind the Docker nginx it is the web URL, e.g.
# http://localhost, because /api is proxied.
# BONFIRE_URL=http://localhost:3000

# Path to the SQLite database file.
# Defaults to /var/lib/bonfire/bonfire.db in Docker, ./bonfire.db locally.
# DATABASE_URL=/var/lib/bonfire/bonfire.db
