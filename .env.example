# Copy this file to `.env` (repo root).
# Docker Compose automatically reads `.env` for variable substitution.

# --- Authentication ---

# The shared API key clients send as the `X-API-Key` header.
#
# Bonfire currently has a single shared key rather than per-user accounts.
# Every authenticated caller is treated as the same admin. Real per-user
# authentication and permissioning is the next planned milestone.
#
# Required in production: the API refuses to start without it, and refuses to
# start if it is left at the development default below.
# Generate one with: `openssl rand -base64 32`
#
# In development this may be left unset, in which case it defaults to
# `dev-api-key-change-in-production`.
BONFIRE_API_KEY=

# --- Server ---

# Port the API listens on. Defaults to 3000.
# PORT=3000

# Public base URL of the API, used by the CLI and for generated links.
# BONFIRE_URL=http://localhost:3000

# Path to the SQLite database file.
# Defaults to /var/lib/bonfire/bonfire.db in Docker, ./bonfire.db locally.
# DATABASE_URL=/var/lib/bonfire/bonfire.db
